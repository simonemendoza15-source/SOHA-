class Espacio:
    po_categoria = "Infraestructura Educativa"

    def __init__(self, id_espacio: int, capacidad: int, nombre: str):
        self._id_espacio = id_espacio
        self._capacidad = capacidad
        self.nombre = nombre

    def idespacio(self):
        print(f"ID del espacio: {self._id_espacio}")

    def evaluar_capacidad(self, limite: int):
        print(f"Capacidad: {self._capacidad} estudiantes")
        print(f"Evaluando capacidad contra {limite} estudiantes")

    def tiene_capacidad(self, num_estudiantes: int) -> bool:
          return self._capacidad >= num_estudiantes


    def mostrar_nombre(self):
        print(f"Espacio de practica: {self.nombre}")


class Lavoratorio(Espacio):
    mi_lavoratorio = "Laboratorio especializado"

    def __init__(self, id_espacio: int, capacidad: int, equipamiento: list):
        super().__init__(id_espacio, capacidad, "Laboratorio de practica")
        self._equipamiento = equipamiento

    def id_espacio(self):
        print(f"ID del laboratorio: {self._id_espacio}")

    def agregar_equipamiento(self, nuevo_equipo: str):
        self._equipamiento.append(nuevo_equipo)
        print(f"Agregando {nuevo_equipo} al laboratorio")

    def mostrar_capacidad(self):
        print(f"Capacidad para {self._capacidad} estudiantes")

    def mostrar_equipamiento(self):
        print(f"Equipamiento: {self._equipamiento}")


class Paralelo:
    mi_paralelo = "Paralelo"

    def __init__(self, id_paralelo: int, num_estudiantes: int, nombre_paralelo: str):
        self._id_paralelo = id_paralelo
        self._num_estudiantes = num_estudiantes
        self.nombre_paralelo = nombre_paralelo

    def idparaleo(self):
        print(f"ID del paralelo: {self._id_paralelo}")

    def agregar_estudiantes(self, cantidad: int):
        self._num_estudiantes += cantidad
        print(f"Se agregaron {cantidad} estudiantes")
        print(f"Total de estudiantes: {self._num_estudiantes}")

    def mostrar_nombre_paralelo(self):
        print(f"Paralelo: {self.nombre_paralelo}")


class Docente:
    mi_docente = "Materia de docente"

    def __init__(self, disponibilidad: list, preferencias: str, descansos: list):
        self._disponibilidad = disponibilidad
        self._preferencias = preferencias
        self.descansos = descansos

    def disponibilidad(self):
        print(f"Disponibilidad: {self._disponibilidad}")

    def cambiar_preferencias(self, nueva_pref: str):
        self._preferencias = nueva_pref
        print(f"Nueva preferencia docente: {nueva_pref}")

    def mostrar_descansos(self):
        print(f"Descansos: {self.descansos}")


class Horario:
    mi_horarioasignado = "Horario de clase"

    def __init__(self, id_horario: int, periodo: str, estado: str):
        self._id_horario = id_horario
        self._estado = estado
        self.periodo = periodo

    def id_horario(self):
        print(f"Horario ID: {self._id_horario}")

    def cambiar_periodo(self, nuevo_periodo: str):
        self.periodo = nuevo_periodo
        print(f"Nuevo periodo: {self.periodo}")

    def mostrar_estado(self):
        print(f"Estado del horario: {self._estado}")


class LaboratorioUniversitario(Lavoratorio, Docente):
    def __init__(self, id_espacio: int, capacidad: int, equipamiento: list,
                 disponibilidad: list, preferencias: str, descansos: list):
        Lavoratorio.__init__(self, id_espacio, capacidad, equipamiento)
        Docente.__init__(self, disponibilidad, preferencias, descansos)

    def mostrar_informacion_completa(self):
        print("=== LABORATORIO UNIVERSITARIO ===")
        self.mostrar_nombre()
        self.mostrar_capacidad()
        self.mostrar_equipamiento()
        self.disponibilidad()
        self.mostrar_descansos()


