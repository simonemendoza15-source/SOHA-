"""
SOHA - Sistema de Horarios Optimizado
Implementación del diagrama de clases UML (Figura 1).

Convención de visibilidad (UML -> Python):
    +  público     -> nombre
    #  protegido   -> _nombre
    -  privado     -> __nombre

Relaciones del diagrama:
    Generalización : Laboratorio, Aula -> Espacio | Docente, Administrador, Estudiante -> Usuario
    Realización    : Horario -> Notificable
    Composición    : Horario *-- BloqueHorario  (el bloque lo crea y posee el horario)
    Asociación     : Horario --> Espacio, Docente, Paralelo (referencias compartidas)
    Agregación     : Materia o-- Paralelo
    Dependencia    : GeneradorHorarios ..> Horario, Reporte (crea) | ..> Materia (usa)
                     Administrador ..> Docente (usa)
"""
from __future__ import annotations

import hashlib
import hmac
import os
import re
from abc import ABC, abstractmethod
from datetime import time
from typing import Callable, Iterable, Iterator

DIAS = ("Lunes", "Martes", "Miercoles", "Jueves", "Viernes", "Sabado")
_EMAIL = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")


# ----------------------------------------------------------------------
# Utilidades internas de validación
# ----------------------------------------------------------------------
def _entero_positivo(valor, nombre: str) -> int:
    if isinstance(valor, bool) or not isinstance(valor, int) or valor <= 0:
        raise ValueError(f"{nombre} debe ser un entero mayor que cero")
    return valor


def _texto(valor, nombre: str) -> str:
    if not isinstance(valor, str) or not valor.strip():
        raise ValueError(f"{nombre} no puede estar vacío")
    return valor.strip()


def _clave_orden(horario: Horario) -> tuple:
    return DIAS.index(horario.bloque.dia), horario.bloque.hora_inicio


# ======================================================================
# «interface» Notificable
# ======================================================================
class Notificable(ABC):
    @abstractmethod
    def enviar_aviso(self) -> None:
        """Notifica a los interesados de un cambio."""


# ======================================================================
# BloqueHorario
# ======================================================================
class BloqueHorario:
    """Franja de tiempo en un día. Es un objeto de valor (inmutable)."""

    def __init__(self, dia: str, hora_inicio: time, hora_fin: time):
        if dia not in DIAS:
            raise ValueError(f"Día inválido: {dia!r}. Use uno de {DIAS}")
        if not isinstance(hora_inicio, time) or not isinstance(hora_fin, time):
            raise TypeError("hora_inicio y hora_fin deben ser datetime.time")
        if hora_inicio >= hora_fin:
            raise ValueError("La hora de inicio debe ser menor que la hora de fin")
        self.__dia = dia
        self.__hora_inicio = hora_inicio
        self.__hora_fin = hora_fin

    @property
    def dia(self) -> str:
        return self.__dia

    @property
    def hora_inicio(self) -> time:
        return self.__hora_inicio

    @property
    def hora_fin(self) -> time:
        return self.__hora_fin

    def duracion_horas(self) -> float:
        ini = self.__hora_inicio.hour + self.__hora_inicio.minute / 60
        fin = self.__hora_fin.hour + self.__hora_fin.minute / 60
        return fin - ini

    def se_solapa_con(self, otro: BloqueHorario) -> bool:
        return (self.__dia == otro.dia
                and self.__hora_inicio < otro.hora_fin
                and otro.hora_inicio < self.__hora_fin)

    def contiene(self, otro: BloqueHorario) -> bool:
        """True si 'otro' cae completamente dentro de este bloque."""
        return (self.__dia == otro.dia
                and self.__hora_inicio <= otro.hora_inicio
                and otro.hora_fin <= self.__hora_fin)

    def es_contiguo_con(self, otro: BloqueHorario) -> bool:
        """True si 'otro' empieza exactamente cuando termina este bloque."""
        return self.__dia == otro.dia and self.__hora_fin == otro.hora_inicio

    def _clave(self) -> tuple:
        return self.__dia, self.__hora_inicio, self.__hora_fin

    def __eq__(self, otro: object) -> bool:
        return isinstance(otro, BloqueHorario) and self._clave() == otro._clave()

    def __hash__(self) -> int:
        return hash(self._clave())

    def __repr__(self) -> str:
        return f"{self.__dia} {self.__hora_inicio:%H:%M}-{self.__hora_fin:%H:%M}"


# ======================================================================
# Usuario (abstracta)
# ======================================================================
class Usuario(ABC):
    _ITERACIONES = 100_000

    def __init__(self, id_usuario: int, nombre: str, email: str, contrasena: str):
        self._id_usuario = _entero_positivo(id_usuario, "id_usuario")     # # idUsuario
        self._nombre = _texto(nombre, "nombre")                           # # nombre
        if not _EMAIL.match(email or ""):
            raise ValueError(f"Correo inválido: {email!r}")
        if not isinstance(contrasena, str) or len(contrasena) < 8:
            raise ValueError("La contraseña debe tener al menos 8 caracteres")
        self.__email = email.strip().lower()                              # - email
        self.__salt = os.urandom(16)                                      # - contrasena (hash)
        self.__hash = self._derivar(contrasena, self.__salt)
        self._sesion_activa = False

    @classmethod
    def _derivar(cls, contrasena: str, salt: bytes) -> bytes:
        return hashlib.pbkdf2_hmac("sha256", contrasena.encode(), salt, cls._ITERACIONES)

    @property
    def id_usuario(self) -> int:
        return self._id_usuario

    @property
    def nombre(self) -> str:
        return self._nombre

    @property
    def email(self) -> str:
        return self.__email

    @property
    def sesion_activa(self) -> bool:
        return self._sesion_activa

    def _validar_credenciales(self, email: str, contrasena: str) -> bool:
        ok_email = hmac.compare_digest(self.__email, (email or "").strip().lower())
        ok_clave = hmac.compare_digest(self.__hash, self._derivar(contrasena or "", self.__salt))
        return ok_email and ok_clave

    def iniciar_sesion(self, email: str, contrasena: str) -> bool:
        self._sesion_activa = self._validar_credenciales(email, contrasena)
        return self._sesion_activa

    def cerrar_sesion(self) -> None:
        self._sesion_activa = False

    @abstractmethod
    def rol(self) -> str:
        ...

    def __repr__(self) -> str:
        return f"<{self.rol()} #{self._id_usuario} {self._nombre}>"


# ======================================================================
# Espacio (abstracta), Laboratorio y Aula
# ======================================================================
class Espacio(ABC):
    mi_categoria = "Infraestructura Educativa"

    def __init__(self, id_espacio: int, capacidad: int, nombre: str):
        self._id_espacio = _entero_positivo(id_espacio, "id_espacio")     # # idEspacio
        self._capacidad = _entero_positivo(capacidad, "capacidad")        # # capacidad
        self.nombre = _texto(nombre, "nombre")

    @property
    def id_espacio(self) -> int:
        return self._id_espacio

    @property
    def capacidad(self) -> int:
        return self._capacidad

    @capacidad.setter
    def capacidad(self, nueva: int) -> None:
        self._capacidad = _entero_positivo(nueva, "capacidad")

    def tiene_capacidad_para(self, n: int) -> bool:
        return self._capacidad >= n

    @abstractmethod
    def es_apto_para(self, materia: Materia) -> bool:
        """True si el espacio sirve para dictar la materia."""

    @abstractmethod
    def descripcion(self) -> str:
        ...

    def __repr__(self) -> str:
        return f"<{type(self).__name__} {self.nombre} cap={self._capacidad}>"


class Laboratorio(Espacio):
    mi_laboratorio = "Laboratorio especializado"

    def __init__(self, id_espacio: int, capacidad: int, nombre: str,
                 equipamiento: Iterable[str] = (), requiere_continuidad: bool = True):
        super().__init__(id_espacio, capacidad, nombre)
        self.__equipamiento = [str(e).strip() for e in equipamiento if str(e).strip()]
        self.__requiere_continuidad = bool(requiere_continuidad)

    @property
    def equipamiento(self) -> tuple[str, ...]:
        return tuple(self.__equipamiento)

    def agregar_equipamiento(self, *equipos: str) -> int:
        nuevos = [str(e).strip() for e in equipos if str(e).strip()]
        self.__equipamiento.extend(nuevos)
        return len(nuevos)

    def requiere_continuidad(self) -> bool:
        """Las prácticas de laboratorio deben dictarse en bloques seguidos."""
        return self.__requiere_continuidad

    def es_apto_para(self, materia: Materia) -> bool:
        return materia.requiere_laboratorio()

    def descripcion(self) -> str:
        return (f"Laboratorio {self.nombre}: {self._capacidad} cupos, "
                f"{len(self.__equipamiento)} equipos")


class Aula(Espacio):
    def __init__(self, id_espacio: int, capacidad: int, nombre: str,
                 tiene_pizarra_digital: bool = False):
        super().__init__(id_espacio, capacidad, nombre)
        self.__tiene_pizarra_digital = bool(tiene_pizarra_digital)

    @property
    def tiene_pizarra_digital(self) -> bool:
        return self.__tiene_pizarra_digital

    def es_apta_para_clase_teorica(self) -> bool:
        """Toda aula habilitada sirve para teoría; la pizarra digital es solo una preferencia."""
        return True

    def es_apto_para(self, materia: Materia) -> bool:
        return not materia.requiere_laboratorio() and self.es_apta_para_clase_teorica()

    def descripcion(self) -> str:
        pizarra = "con" if self.__tiene_pizarra_digital else "sin"
        return f"Aula {self.nombre}: {self._capacidad} cupos, {pizarra} pizarra digital"


# ======================================================================
# Paralelo y Materia (Materia agrega Paralelos)
# ======================================================================
class Paralelo:
    def __init__(self, id_paralelo: int, nombre_paralelo: str,
                 num_estudiantes: int = 0, cupo_maximo: int = 40):
        if isinstance(num_estudiantes, bool) or not isinstance(num_estudiantes, int) or num_estudiantes < 0:
            raise ValueError("num_estudiantes debe ser un entero mayor o igual a cero")
        if num_estudiantes > _entero_positivo(cupo_maximo, "cupo_maximo"):
            raise ValueError("num_estudiantes no puede superar el cupo máximo")
        self.__id_paralelo = _entero_positivo(id_paralelo, "id_paralelo")
        self.nombre_paralelo = _texto(nombre_paralelo, "nombre_paralelo")
        self.__num_estudiantes = num_estudiantes
        self.__cupo_maximo = cupo_maximo
        self._materia: Materia | None = None
        self._horarios: list[Horario] = []

    @property
    def id_paralelo(self) -> int:
        return self.__id_paralelo

    @property
    def num_estudiantes(self) -> int:
        return self.__num_estudiantes

    @property
    def cupo_maximo(self) -> int:
        return self.__cupo_maximo

    @property
    def materia(self) -> Materia | None:
        return self._materia

    @property
    def horarios(self) -> list[Horario]:
        return sorted(self._horarios, key=_clave_orden)

    def tiene_cupo(self) -> bool:
        return self.__num_estudiantes < self.__cupo_maximo

    def registrar_estudiante(self) -> bool:
        if not self.tiene_cupo():
            return False
        self.__num_estudiantes += 1
        return True

    def retirar_estudiante(self) -> bool:
        if self.__num_estudiantes == 0:
            return False
        self.__num_estudiantes -= 1
        return True

    def asignar_horario(self, horario: Horario) -> None:
        if horario not in self._horarios:
            self._horarios.append(horario)

    def __repr__(self) -> str:
        return f"<Paralelo {self.nombre_paralelo} {self.__num_estudiantes}/{self.__cupo_maximo}>"


class Materia:
    def __init__(self, id_materia: int, nombre: str, carga_horaria: int,
                 es_practica: bool = False):
        self.__id_materia = _entero_positivo(id_materia, "id_materia")
        self.__nombre = _texto(nombre, "nombre")
        self.__carga_horaria = _entero_positivo(carga_horaria, "carga_horaria")  # horas/semana por paralelo
        self.__es_practica = bool(es_practica)
        self.__paralelos: list[Paralelo] = []

    @property
    def id_materia(self) -> int:
        return self.__id_materia

    @property
    def nombre(self) -> str:
        return self.__nombre

    @property
    def carga_horaria(self) -> int:
        return self.__carga_horaria

    @property
    def es_practica(self) -> bool:
        return self.__es_practica

    @property
    def paralelos(self) -> list[Paralelo]:
        return list(self.__paralelos)

    def agregar_paralelo(self, paralelo: Paralelo) -> None:
        if not isinstance(paralelo, Paralelo):
            raise TypeError("Se esperaba un Paralelo")
        if paralelo.materia not in (None, self):
            raise ValueError(f"{paralelo.nombre_paralelo} ya pertenece a otra materia")
        if paralelo not in self.__paralelos:
            self.__paralelos.append(paralelo)
            paralelo._materia = self

    def calcular_carga_total(self) -> int:
        """Horas semanales totales: carga de la materia por cada paralelo."""
        return self.__carga_horaria * len(self.__paralelos)

    def requiere_laboratorio(self) -> bool:
        return self.__es_practica

    def __repr__(self) -> str:
        return f"<Materia {self.__nombre} {self.__carga_horaria}h>"


# ======================================================================
# Docente, Estudiante, Administrador
# ======================================================================
class Docente(Usuario):
    def __init__(self, id_usuario: int, nombre: str, email: str, contrasena: str,
                 preferencias: str = "",
                 disponibilidad: Iterable[BloqueHorario] = (),
                 descansos: Iterable[BloqueHorario] = ()):
        super().__init__(id_usuario, nombre, email, contrasena)
        self.__preferencias = preferencias
        self.__disponibilidad: list[BloqueHorario] = []
        self.__descansos: list[BloqueHorario] = []
        self.registrar_disponibilidad(disponibilidad)
        for d in descansos:
            self.registrar_descanso(d)
        self._horarios: list[Horario] = []

    @staticmethod
    def _validar_bloques(bloques: Iterable[BloqueHorario]) -> list[BloqueHorario]:
        lista = list(bloques)
        if not all(isinstance(b, BloqueHorario) for b in lista):
            raise TypeError("Todos los elementos deben ser BloqueHorario")
        return lista

    @property
    def preferencias(self) -> str:
        return self.__preferencias

    def cambiar_preferencias(self, nueva: str) -> None:
        self.__preferencias = nueva.strip()

    @property
    def disponibilidad(self) -> list[BloqueHorario]:
        return list(self.__disponibilidad)

    @property
    def descansos(self) -> list[BloqueHorario]:
        return list(self.__descansos)

    def registrar_disponibilidad(self, bloques: Iterable[BloqueHorario]) -> None:
        self.__disponibilidad = self._validar_bloques(bloques)

    def registrar_descanso(self, bloque: BloqueHorario) -> None:
        self.__descansos.extend(self._validar_bloques([bloque]))

    def esta_disponible(self, bloque: BloqueHorario) -> bool:
        dentro = any(d.contiene(bloque) for d in self.__disponibilidad)
        en_descanso = any(r.se_solapa_con(bloque) for r in self.__descansos)
        return dentro and not en_descanso

    def asignar_horario(self, horario: Horario) -> None:
        if horario not in self._horarios:
            self._horarios.append(horario)

    def consultar_horario(self) -> list[Horario]:
        return sorted(self._horarios, key=_clave_orden)

    def rol(self) -> str:
        return "Docente"


class Estudiante(Usuario):
    def __init__(self, id_usuario: int, nombre: str, email: str, contrasena: str,
                 carrera: str):
        super().__init__(id_usuario, nombre, email, contrasena)
        self.__carrera = _texto(carrera, "carrera")
        self._paralelos: list[Paralelo] = []

    @property
    def carrera(self) -> str:
        return self.__carrera

    def inscribir(self, paralelo: Paralelo) -> bool:
        if paralelo in self._paralelos or not paralelo.registrar_estudiante():
            return False
        self._paralelos.append(paralelo)
        return True

    def retirar(self, paralelo: Paralelo) -> bool:
        if paralelo not in self._paralelos:
            return False
        self._paralelos.remove(paralelo)
        paralelo.retirar_estudiante()
        return True

    def consultar_horario(self) -> list[Horario]:
        return sorted((h for p in self._paralelos for h in p.horarios), key=_clave_orden)

    def rol(self) -> str:
        return "Estudiante"


class Administrador(Usuario):
    def __init__(self, id_usuario: int, nombre: str, email: str, contrasena: str,
                 rol_academico: str = "Coordinador"):
        super().__init__(id_usuario, nombre, email, contrasena)
        self.__rol_academico = _texto(rol_academico, "rol_academico")
        self._docentes: list[Docente] = []
        self._materias: list[Materia] = []
        self._horarios_publicados: list[Horario] = []

    @property
    def rol_academico(self) -> str:
        return self.__rol_academico

    @property
    def docentes(self) -> list[Docente]:
        return list(self._docentes)

    @property
    def materias(self) -> list[Materia]:
        return list(self._materias)

    @property
    def horarios_publicados(self) -> list[Horario]:
        return sorted(self._horarios_publicados, key=_clave_orden)

    def registrar_docente(self, docente: Docente) -> None:
        if not isinstance(docente, Docente):
            raise TypeError("Se esperaba un Docente")
        if docente not in self._docentes:
            self._docentes.append(docente)

    def registrar_materia(self, materia: Materia) -> None:
        if not isinstance(materia, Materia):
            raise TypeError("Se esperaba una Materia")
        if materia not in self._materias:
            self._materias.append(materia)

    def ingresar_datos(self, docentes: Iterable[Docente] = (),
                       materias: Iterable[Materia] = ()) -> None:
        for d in docentes:
            self.registrar_docente(d)
        for m in materias:
            self.registrar_materia(m)

    def gestionar_combo(self, horario: Horario) -> bool:
        """Revisa la combinación docente-espacio-bloque-paralelo sin publicarla."""
        problemas = horario.diagnosticar()
        if problemas:
            print("  [X] Combinación inválida: " + "; ".join(problemas))
            return False
        if any(horario.choca_con(h) for h in self._horarios_publicados if h is not horario):
            print("  [X] Combinación en conflicto con otro horario publicado")
            return False
        return True

    def publicar_horario(self, horario: Horario) -> bool:
        if horario in self._horarios_publicados:
            print("  [X] El horario ya está publicado")
            return False
        if not self.gestionar_combo(horario):
            return False
        self._horarios_publicados.append(horario)
        horario.docente.asignar_horario(horario)
        horario.paralelo.asignar_horario(horario)
        horario.enviar_aviso()
        return True

    def reprogramar_horario(self, horario: Horario, dia: str,
                            hora_inicio: time, hora_fin: time) -> bool:
        """Mueve un horario publicado verificando conflictos con los demás."""
        if horario not in self._horarios_publicados:
            raise ValueError("El horario no está publicado")
        return horario.reprogramar(dia, hora_inicio, hora_fin, self._horarios_publicados)

    def rol(self) -> str:
        return "Administrador"


# ======================================================================
# Horario («realiza» Notificable; compuesto por BloqueHorario)
# ======================================================================
class Horario(Notificable):
    def __init__(self, id_horario: int, paralelo: Paralelo, docente: Docente,
                 espacio: Espacio, dia: str, hora_inicio: time, hora_fin: time):
        if not isinstance(paralelo, Paralelo) or paralelo.materia is None:
            raise ValueError("Se requiere un Paralelo que pertenezca a una Materia")
        if not isinstance(docente, Docente):
            raise TypeError("Se esperaba un Docente")
        if not isinstance(espacio, Espacio):
            raise TypeError("Se esperaba un Espacio")
        self.__id_horario = _entero_positivo(id_horario, "id_horario")
        self.__version = 1
        self.__bloque = BloqueHorario(dia, hora_inicio, hora_fin)   # composición
        self._paralelo = paralelo
        self._docente = docente
        self._espacio = espacio
        self._avisos: list[str] = []

    @property
    def id_horario(self) -> int:
        return self.__id_horario

    @property
    def version(self) -> int:
        return self.__version

    @property
    def bloque(self) -> BloqueHorario:
        return self.__bloque

    @property
    def paralelo(self) -> Paralelo:
        return self._paralelo

    @property
    def materia(self) -> Materia:
        return self._paralelo.materia

    @property
    def docente(self) -> Docente:
        return self._docente

    @property
    def espacio(self) -> Espacio:
        return self._espacio

    @property
    def avisos(self) -> list[str]:
        return list(self._avisos)

    def diagnosticar(self) -> list[str]:
        """Razones por las que el horario no es válido (lista vacía si lo es)."""
        problemas = []
        if not self._espacio.es_apto_para(self.materia):
            problemas.append(f"{self._espacio.nombre} no es apto para {self.materia.nombre}")
        if not self._espacio.tiene_capacidad_para(self._paralelo.num_estudiantes):
            problemas.append(f"{self._espacio.nombre} no tiene capacidad para "
                             f"{self._paralelo.num_estudiantes} estudiantes")
        if not self._docente.esta_disponible(self.__bloque):
            problemas.append(f"{self._docente.nombre} no está disponible en {self.__bloque}")
        return problemas

    def validar(self) -> bool:
        return not self.diagnosticar()

    def choca_con(self, otro: Horario) -> bool:
        if not self.__bloque.se_solapa_con(otro.bloque):
            return False
        return (self._espacio is otro.espacio
                or self._docente is otro.docente
                or self._paralelo is otro.paralelo)

    def reprogramar(self, dia: str, hora_inicio: time, hora_fin: time,
                    otros: Iterable[Horario] = ()) -> bool:
        """Cambia el bloque. Si queda inválido o en conflicto, lo deja como estaba."""
        anterior = self.__bloque
        self.__bloque = BloqueHorario(dia, hora_inicio, hora_fin)
        if not self.validar() or any(self.choca_con(o) for o in otros if o is not self):
            self.__bloque = anterior
            return False
        self.__version += 1
        self.enviar_aviso()
        return True

    def enviar_aviso(self) -> None:
        mensaje = (f"Horario #{self.__id_horario} v{self.__version}: {self.resumen()} "
                   f"-> notificado a {self._docente.nombre} y al paralelo "
                   f"{self._paralelo.nombre_paralelo}")
        self._avisos.append(mensaje)
        print(f"  [AVISO] {mensaje}")

    def resumen(self) -> str:
        return (f"{self.__bloque} | {self.materia.nombre} | {self._paralelo.nombre_paralelo} | "
                f"{self._espacio.nombre} | {self._docente.nombre}")

    def __repr__(self) -> str:
        return f"<Horario #{self.__id_horario} v{self.__version} {self.resumen()}>"


# ======================================================================
# Reporte
# ======================================================================
class Reporte:
    def __init__(self, uso_aulas: float, carga_docente: float):
        if not 0 <= uso_aulas <= 1:
            raise ValueError("uso_aulas debe estar entre 0 y 1")
        if carga_docente < 0:
            raise ValueError("carga_docente no puede ser negativa")
        self.__uso_aulas = float(uso_aulas)
        self.__carga_docente = float(carga_docente)

    @property
    def uso_aulas(self) -> float:
        return self.__uso_aulas

    @property
    def carga_docente(self) -> float:
        return self.__carga_docente

    def generar_resumen(self) -> str:
        return (f"Uso de espacios: {self.__uso_aulas * 100:.1f}% | "
                f"Carga docente promedio: {self.__carga_docente:.1f} h/semana")

    def exportar(self, ruta: str = "reporte_soha.txt") -> None:
        with open(ruta, "w", encoding="utf-8") as archivo:
            archivo.write(self.generar_resumen() + "\n")


# ======================================================================
# GeneradorHorarios
# ======================================================================
Restriccion = Callable[[Horario], bool]


class GeneradorHorarios:
    """Construye horarios sin conflictos con un algoritmo voraz.

    - Prefiere al docente cuya preferencia coincide con la materia.
    - Elige el espacio más ajustado (aulas con pizarra digital primero).
    - Las prácticas en laboratorios que requieren continuidad se programan en
      bloques consecutivos cuando es posible.
    """

    def __init__(self, docentes: Iterable[Docente], espacios: Iterable[Espacio],
                 bloques: Iterable[BloqueHorario],
                 restricciones: Iterable[Restriccion] = ()):
        self._docentes = list(docentes)
        self._espacios = list(espacios)
        self._bloques = sorted(bloques, key=lambda b: (DIAS.index(b.dia), b.hora_inicio))
        self._restricciones: list[Restriccion] = list(restricciones)
        self._horarios: list[Horario] = []

    def agregar_restriccion(self, restriccion: Restriccion) -> None:
        if not callable(restriccion):
            raise TypeError("La restricción debe ser una función Horario -> bool")
        self._restricciones.append(restriccion)

    # -- apoyo --------------------------------------------------------
    def _cumple(self, candidato: Horario) -> bool:
        return (candidato.validar()
                and not any(candidato.choca_con(h) for h in self._horarios)
                and all(r(candidato) for r in self._restricciones))

    def _docentes_ordenados(self, materia: Materia) -> list[Docente]:
        return sorted(self._docentes, key=lambda d: d.preferencias != materia.nombre)

    def _espacios_ordenados(self) -> list[Espacio]:
        return sorted(self._espacios,
                      key=lambda e: (not getattr(e, "tiene_pizarra_digital", False), e.capacidad))

    def _construir(self, paralelo: Paralelo, docente: Docente, espacio: Espacio,
                   bloque: BloqueHorario, desplazamiento: int = 0) -> Horario:
        return Horario(len(self._horarios) + 1 + desplazamiento, paralelo, docente,
                       espacio, bloque.dia, bloque.hora_inicio, bloque.hora_fin)

    def _rachas(self, n: int) -> Iterator[list[BloqueHorario]]:
        for i in range(len(self._bloques) - n + 1):
            ventana = self._bloques[i:i + n]
            if all(a.es_contiguo_con(b) for a, b in zip(ventana, ventana[1:])):
                yield ventana

    def _asignar_continuo(self, paralelo: Paralelo, n: int) -> list[Horario] | None:
        materia = paralelo.materia
        labs = [e for e in self._espacios_ordenados()
                if isinstance(e, Laboratorio) and e.requiere_continuidad()]
        for ventana in self._rachas(n):
            for docente in self._docentes_ordenados(materia):
                for lab in labs:
                    grupo = [self._construir(paralelo, docente, lab, b, i)
                             for i, b in enumerate(ventana)]
                    if all(self._cumple(h) for h in grupo):
                        return grupo
        return None

    def _asignar_suelto(self, paralelo: Paralelo, cantidad: int) -> int:
        materia, asignados = paralelo.materia, 0
        for bloque in self._bloques:
            if asignados >= cantidad:
                break
            for docente in self._docentes_ordenados(materia):
                for espacio in self._espacios_ordenados():
                    candidato = self._construir(paralelo, docente, espacio, bloque)
                    if self._cumple(candidato):
                        self._horarios.append(candidato)
                        asignados += 1
                        break
                else:
                    continue
                break
        return asignados

    # -- API del diagrama ----------------------------------------------
    def generar(self, materias: Iterable[Materia] | None = None) -> list[Horario]:
        self._horarios = []
        for materia in (materias or []):
            usa_continuidad = (materia.requiere_laboratorio() and materia.carga_horaria > 1
                               and any(isinstance(e, Laboratorio) and e.requiere_continuidad()
                                       for e in self._espacios))
            for paralelo in materia.paralelos:
                pendientes = materia.carga_horaria
                if usa_continuidad:
                    grupo = self._asignar_continuo(paralelo, pendientes)
                    if grupo:
                        self._horarios.extend(grupo)
                        pendientes = 0
                asignados = self._asignar_suelto(paralelo, pendientes) if pendientes else 0
                if pendientes and asignados < pendientes:
                    print(f"  [!] {materia.nombre} - {paralelo.nombre_paralelo}: "
                          f"{asignados}/{pendientes} bloques asignados")
        return list(self._horarios)

    def generar_reporte(self) -> Reporte:
        horas_ocupadas = sum(h.bloque.duracion_horas() for h in self._horarios)
        horas_disponibles = len(self._espacios) * sum(b.duracion_horas() for b in self._bloques)
        uso = min(1.0, horas_ocupadas / horas_disponibles) if horas_disponibles else 0.0
        carga = horas_ocupadas / len(self._docentes) if self._docentes else 0.0
        return Reporte(uso, carga)


